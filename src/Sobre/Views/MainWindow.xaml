<Window x:Class="Sobre.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Sobre.Controls"
        xmlns:vm="clr-namespace:Sobre.ViewModels"
        xmlns:views="clr-namespace:Sobre.Views"
        xmlns:conv="clr-namespace:Sobre.Converters"
        Title="Sobre"
        Width="1180" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RootFillSolid}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Window backdrop: Mica/Acrylic shows through here -->
        <Border x:Name="Backdrop" Background="{DynamicResource RootFill}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ============================ TITLE BAR ============================ -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/sobre_256.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Sobre" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <!-- central search: matches the mockup's centred field -->
                <Border Grid.Column="1" MaxWidth="430" Height="26" Margin="20,0" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFill}"
                        BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconPresenter Grid.Column="0" Icon="Search" Size="13" Margin="9,0,5,0"
                                                Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                 SelectionBrush="{DynamicResource AccentFill}"
                                 Tag="Search mail, people, or subjects" FontSize="12.5"
                                 FocusVisualStyle="{StaticResource NoFocusVisual}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                                        <TextBlock Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"
                                                   FontSize="13" Visibility="Collapsed" x:Name="Ph" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="24"
                                Margin="0,0,3,0" Padding="2"
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}"
                                ToolTip="Clear search">
                            <controls:IconPresenter Icon="Dismiss" Size="12" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize" ToolTip="Minimize">
                        <controls:IconPresenter Icon="Subtract" Size="14" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize" ToolTip="Maximize">
                        <controls:IconPresenter x:Name="MaxGlyph" Icon="Square" Size="13" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose" ToolTip="Close">
                        <controls:IconPresenter Icon="Dismiss" Size="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================ BODY ============================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========== account rail (avatar strip) ========== -->
                <Border Grid.Column="0" Width="48" Background="{DynamicResource LayerFill}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,9,0,9">

                        <!-- Settings pinned to the bottom of the rail -->
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                Margin="0,4,0,0" Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings (Ctrl+,)">
                            <controls:IconPresenter Icon="Settings" Size="17" />
                        </Button>

                        <!-- Everything else stacks from the top; the + follows the accounts -->
                        <StackPanel VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                    Margin="0,0,0,7" Background="{DynamicResource AccentFill}"
                                    Foreground="{DynamicResource OnAccentText}"
                                    Command="{Binding ComposeNewCommand}" ToolTip="New message (Ctrl+N)">
                                <controls:IconPresenter Icon="Compose" Size="16" Filled="True"
                                                        Foreground="{DynamicResource OnAccentText}" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="34"
                                                Margin="0,2" Padding="0"
                                                Command="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Email}">
                                            <Grid>
                                                <Ellipse Width="28" Height="28">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding AccentHex, Converter={StaticResource AccountColor}}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add account: directly under the last provider, follows it downward -->
                            <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32"
                                    Margin="0,4,0,0" Command="{Binding AddAccountCommand}" ToolTip="Add an account">
                                <controls:IconPresenter Icon="Add" Size="15" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ========== three panes ========== -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="204" MinWidth="180" MaxWidth="440" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition x:Name="ListColumn" Width="345" MinWidth="280" MaxWidth="660" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== folder sidebar ===== -->
                    <Border Grid.Column="0" Background="{DynamicResource LayerFill}">
                        <DockPanel>
                            <!-- account header -->
                            <Button DockPanel.Dock="Top" Style="{StaticResource SubtleButtonStyle}" Margin="8,9,8,5"
                                    Padding="6,6" HorizontalContentAlignment="Stretch"
                                    Command="{Binding OpenSettingsCommand}" ToolTip="Account settings">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="29" Height="29" CornerRadius="15" Grid.Column="0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding CurrentAccount.AccentHex, Converter={StaticResource AccountColor}, FallbackValue=#0078D4}" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding AccountHeaderInitials}" Foreground="White" FontSize="12"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AccountHeaderName}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding AccountHeaderEmail}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:IconPresenter Grid.Column="2" Icon="ChevronDown" Size="12"
                                                            Foreground="{DynamicResource TextTertiary}" />
                                </Grid>
                            </Button>

                            <Border DockPanel.Dock="Top" Height="1" Margin="12,2,12,7" Background="{DynamicResource Divider}" />

                            <!-- compose button -->
                            <Button DockPanel.Dock="Top" Style="{StaticResource AccentButtonStyle}" Margin="8,0,8,10"
                                    Height="30" HorizontalContentAlignment="Center"
                                    Command="{Binding ComposeNewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconPresenter Icon="Compose" Size="15" Filled="True"
                                                            Foreground="{DynamicResource OnAccentText}" />
                                    <TextBlock Text="New message" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource OnAccentText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- footer: sync -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="8,6,8,8">
                                <Border Height="1" Margin="0,0,0,6" Background="{DynamicResource Divider}" />
                                <Button Style="{StaticResource SubtleButtonStyle}" HorizontalContentAlignment="Left"
                                        Padding="6,5" Command="{Binding SyncCommand}" ToolTip="Sync now">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconPresenter Icon="ArrowSync" Size="14"
                                                                Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="Sync now" Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ConnectionState}" Margin="7,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="86" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- folder list: NavigationView-style selection with live unread badges -->
                            <ListBox Style="{StaticResource NavListBox}"
                                     ItemsSource="{Binding Folders}"
                                     SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                     Margin="0,0,0,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconPresenter Grid.Column="0" Size="15" Margin="10,0,0,0"
                                                                    Icon="{Binding Kind, Converter={StaticResource FolderIcon}, FallbackValue=Folder}"
                                                                    Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,8,0"
                                                       VerticalAlignment="Center" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" MinWidth="17" Height="17" CornerRadius="8.5"
                                                    Background="{DynamicResource AccentFill}" Padding="5,0" Margin="0,0,7,0"
                                                    Visibility="{Binding Unread, Converter={StaticResource CountToVis}}">
                                                <TextBlock Text="{Binding Unread, Converter={StaticResource UnreadBadge}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OnAccentText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False" DragCompleted="OnPaneResized" />

                    <!-- ===== message list ===== -->
                    <Border Grid.Column="2" Background="{DynamicResource LayerFillAlt}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="13,10,7,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FolderTitle}" FontSize="17.5" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding ListCountText}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="28" Command="{Binding ToggleUnreadOnlyCommand}"
                                            ToolTip="Show unread only">
                                        <controls:IconPresenter Icon="MailUnread" Size="15" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="28" Command="{Binding ToggleFlaggedOnlyCommand}"
                                            ToolTip="Show flagged only">
                                        <controls:IconPresenter Icon="Flag" Size="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border DockPanel.Dock="Top" Height="1" Margin="13,0,13,3" Background="{DynamicResource Divider}" />

                            <Grid>
                                <ListBox Style="{StaticResource MessageListBox}"
                                         ItemsSource="{Binding Messages}"
                                         SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                         Margin="0,4,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,7,10,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="27" Height="27" VerticalAlignment="Top" Margin="0,1,10,0">
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding AvatarColor, Converter={StaticResource AccountColor}}" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding AvatarText}" Foreground="White" FontSize="10.5"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border x:Name="UnreadDot" Width="7" Height="7" CornerRadius="3.5"
                                                            Background="{DynamicResource AccentFill}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0"
                                                            Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding FromName}" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontWeight="{Binding IsUnread, Converter={StaticResource UnreadWeight}}">
                                                            <TextBlock.Foreground>
                                                                <Binding Path="IsUnread" Converter="{StaticResource UnreadBrush}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" FontSize="10.5"
                                                                   Margin="8,0,0,0" Foreground="{DynamicResource TextTertiary}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Subject}" FontSize="12" Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontWeight="{Binding IsUnread, Converter={StaticResource UnreadWeight}}"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Preview}" FontSize="11.5" Margin="0,1,0,0"
                                                               MaxHeight="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               Visibility="{Binding DataContext.Settings.ShowPreviewText, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <controls:IconPresenter Icon="Attach" Size="11" Margin="0,0,4,0"
                                                                                Foreground="{DynamicResource TextTertiary}"
                                                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                                                        <controls:IconPresenter Icon="Star" Size="11" Filled="True"
                                                                                Foreground="{DynamicResource WarnFill}"
                                                                                Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- empty list state -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}">
                                    <controls:IconPresenter Icon="MailRead" Size="44"
                                                            Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Text="Nothing here yet" Margin="0,12,0,0" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="Messages will appear here once they arrive."
                                               Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                                               FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False" DragCompleted="OnPaneResized" />

                    <!-- ===== reading pane ===== -->
                    <Border Grid.Column="4" Background="{DynamicResource ReadPaneFill}">
                        <Grid>
                            <!-- empty -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowEmptyReader, Converter={StaticResource BoolToVis}}">
                                <Image Source="pack://application:,,,/Assets/emblem.png" Width="64" Height="64"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Select a message" Margin="0,14,0,0" HorizontalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Choose something from the list to read it here."
                                           Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>

                            <!-- reader -->
                            <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">

                                <!-- command bar -->
                                <Border DockPanel.Dock="Top" Padding="12,5,12,5">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding ReplyCommand}" ToolTip="Reply (Ctrl+R)">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconPresenter Icon="ArrowReply" Size="14" Foreground="{DynamicResource AccentText}" />
                                                    <TextBlock Text="Reply" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding ReplyAllCommand}" ToolTip="Reply all (Ctrl+Shift+R)">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconPresenter Icon="ArrowReplyAll" Size="14" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="Reply all" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{Binding ForwardCommand}" ToolTip="Forward">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconPresenter Icon="ArrowForward" Size="14" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="Forward" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding FlagCommand}" ToolTip="Flag">
                                                <controls:IconPresenter Icon="Star" Size="16" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ArchiveCommand}" ToolTip="Archive">
                                                <controls:IconPresenter Icon="Archive" Size="16" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Delete">
                                                <controls:IconPresenter Icon="Delete" Size="16" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleUnreadCommand}" ToolTip="Mark read / unread">
                                                <controls:IconPresenter Icon="MailRead" Size="16" />
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border DockPanel.Dock="Top" Height="1" Margin="14,0" Background="{DynamicResource Divider}" />

                                <!-- header -->
                                <StackPanel DockPanel.Dock="Top" Margin="20,16,20,10">
                                    <TextBlock Text="{Binding SelectedMessage.Subject}" FontSize="19" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="31" Height="31" VerticalAlignment="Top">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding SelectedMessage.AvatarColor, Converter={StaticResource AccountColor}}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SelectedMessage.AvatarText}" Foreground="White"
                                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SelectedMessage.FromName}" FontWeight="SemiBold"
                                                           FontSize="13.5" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding SelectedMessage.FromAddress, StringFormat=' &lt;{0}&gt;'}"
                                                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                           VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="to " FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                                <TextBlock Text="{Binding DetailToText}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedMessage.Date, StringFormat='{}{0:ddd, d MMM yyyy  h:mm tt}'}"
                                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DetailCcText, StringFormat='cc: {0}'}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Right"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasCc, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- attachments -->
                                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding AttachmentList}"
                                              Margin="20,0,20,10"
                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconPresenter Icon="Attach" Size="14"
                                                                            Foreground="{DynamicResource AccentText}" />
                                                    <TextBlock Text="{Binding FileName}" Margin="8,0,0,0" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- encrypted banner -->
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSubtleFill}" Margin="20,0,20,10"
                                        CornerRadius="6" Padding="12,8"
                                        Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconPresenter Icon="Shield" Size="14" Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="Attachments are never opened automatically. Remote images in this message are blocked."
                                                   Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource AccentText}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- body -->
                                <FlowDocumentScrollViewer x:Name="ReaderViewer"
                                                          Margin="2,0,0,0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          IsToolBarVisible="False"
                                                          IsSelectionEnabled="True"
                                                          Background="Transparent"
                                                          Zoom="100"
                                                          Padding="0" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================ STATUS BAR ============================ -->
            <Border Grid.Row="2" Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="18" Height="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsBusy}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnreadTotalText}" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DateText}" FontSize="11" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClockText}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ OVERLAYS ============================ -->
        <Grid x:Name="OverlayHost">
            <!-- toasts -->
            <ItemsControl ItemsSource="{Binding Toasts}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Margin="0,0,16,36" Width="330">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource FlyoutFill}" BorderBrush="{DynamicResource FlyoutStroke}"
                                BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.28" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconPresenter Grid.Column="0" Icon="{Binding Glyph}" Size="18"
                                                        Foreground="{Binding Brush}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- app lock: sits above everything until the password is accepted -->
            <views:LockScreen DataContext="{Binding}" />

            <!-- compose window -->
            <views:ComposeWindow DataContext="{Binding}" />
            <!-- add-account dialog -->
            <views:AddAccountWindow DataContext="{Binding}" />
            <!-- settings -->
            <views:SettingsPane DataContext="{Binding}" />
        </Grid>
    </Grid>
</Window>

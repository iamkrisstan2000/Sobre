<UserControl x:Class="Sobre.Views.LockScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sobre.Controls">

    <!--
      Visibility is driven by a trigger on IsLocked rather than bound on UserControl.Visibility,
      because setting Visibility from inside the control's own template would be clobbered by the
      binding. Triggers also keep working when the view model raises PropertyChanged.
    -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>


    <UserControl.Resources>
        <!-- Sign-in field: roomy, centred text -->
        <Style x:Key="PinBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" Focusable="False" />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" Margin="-2"
                                    BorderBrush="{DynamicResource AccentFill}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Full-window scrim over the (already blurred-looking) shell -->
    <Grid Background="{DynamicResource ScrimFill}">

        <Border Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource FlyoutFill}" BorderBrush="{DynamicResource FlyoutStroke}"
                BorderThickness="1" CornerRadius="10" Padding="28,26,28,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="14" Opacity="0.45" Color="Black" />
            </Border.Effect>

            <StackPanel>
                <Image Source="pack://application:,,,/Assets/emblem.png" Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />

                <TextBlock Text="Sobre is locked" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="HintText" Text="Enter your password to open your mail."
                           FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextTertiary}" TextAlignment="Center" TextWrapping="Wrap" />

                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PinBox}" Margin="0,18,0,0"
                             KeyDown="OnPasswordKeyDown" />

                <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ErrorFill}"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />

                <Button x:Name="UnlockButton" Style="{StaticResource AccentButtonStyle}" Margin="0,14,0,0"
                        Height="36" HorizontalContentAlignment="Center" Click="OnUnlock">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconPresenter Icon="LockClosed" Size="15" Filled="True"
                                                Foreground="{DynamicResource OnAccentText}" />
                        <TextBlock Text="Unlock" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{DynamicResource OnAccentText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SubtleButtonStyle}" Margin="0,6,0,0" Click="OnQuit"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Quit Sobre" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </Button>

                <TextBlock Text="Your mail stays sealed on this PC until you unlock."
                           FontSize="10.5" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextTertiary}" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
